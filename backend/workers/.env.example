# Proxy Configuration
# 프록시 서비스 인증 정보

# Smartproxy (추천: 가성비)
# 가입: https://smartproxy.com
# 가격: $75/월 (5GB)
SMARTPROXY_USERNAME=your-username
SMARTPROXY_PASSWORD=your-password

# Bright Data (추천: 대규모)
# 가입: https://brightdata.com
# 가격: $500/월 (40GB)
BRIGHTDATA_USERNAME=your-username
BRIGHTDATA_PASSWORD=your-password

# 사용할 프록시 프로바이더 선택
PROXY_PROVIDER=smartproxy
# 옵션: smartproxy, brightdata, local

# 프록시 풀 설정
PROXY_POOL_SIZE=50
# 프록시 풀 크기 (권장: 50~100)

PROXY_COUNTRY=KR
# 기본 국가 코드 (KR, US, JP, CN 등)

# 헬스체크 간격 (밀리초)
PROXY_HEALTH_CHECK_INTERVAL=300000
# 기본: 5분 (300000ms)
