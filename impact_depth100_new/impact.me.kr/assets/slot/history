    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('modalDeleteMember');
            const host = document.getElementById('delAnim');

            // 없으면 바로 종료
            if (!modal || !host || !window.lottie) return;

            const anim = lottie.loadAnimation({
                container: host,
                renderer: 'svg',
                loop: false,
                autoplay: false,
                path: '/images/jKRVRZValr.json'
            });

            modal.addEventListener('shown.bs.modal', () => anim.goToAndPlay(0, true));
            modal.addEventListener('hide.bs.modal', () => anim.stop());
        });
    </script>

    




    <script>
                    </script>
        <script src="https://npmcdn.com/flatpickr/dist/flatpickr.min.js"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/ko.js"></script>
    <script>
        $('.sort').on('click', function (e) {
            e.preventDefault();
            $('#ssort').val($(this).data('ssort'));
            $('#sorder').val($(this).data('sorder'));
            $('#form-search').submit();
        });

        $('#select-limit').on('change', function () {
            $('#limit').val(this.value);
            $('#form-search').submit();
        });

        flatpickr(".picker-range", { locale: "ko" });

        function getRowChecks() { return $("input[name='CHK_ID']"); }
        function syncSelectAll() {
            const $rows = getRowChecks();
            const sel = $rows.filter(':checked').length;
            const all = $rows.length > 0 && sel === $rows.length;
            $('#select-all,#select-all-m').prop('checked', all);
        }
        function setAll(checked) {
            getRowChecks().prop('checked', checked);
            $('#select-all,#select-all-m').prop('checked', checked);
        }
        $(document).on('change', "input[name='CHK_ID']", syncSelectAll);
        $('#select-all').on('change', function () { setAll(this.checked); });
        $('#select-all-m').on('change', function () { setAll(this.checked); });

        function getCheckedIds() { return $("input[name='CHK_ID']:checked").map(function () { return this.value; }).get(); }

        $('#btn-confirm').on('click', function () {
            const ids = getCheckedIds();
            if (ids.length < 1) { alert('처리할 내역을 선택해주세요.'); return; }
            if (confirm('선택한 내역 ' + ids.length + '건을 확인 처리하겠습니까?')) {
                $.ajax({
                    headers: { 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') },
                    url: '/slot/history/confirm', method: 'POST', dataType: 'JSON', data: { history_ids: ids },
                    success: r => { alert(r.message); if (r.result === 'success') location.reload(); },
                    error: x => { alert('실패했습니다'); console.log(x); }
                });
            }
        });

        $('#btn-confirm-cancel').on('click', function () {
            const ids = getCheckedIds();
            if (ids.length < 1) { alert('처리할 내역을 선택해주세요.'); return; }
            if (confirm('선택한 내역 ' + ids.length + '건을 미확인 처리하겠습니까?')) {
                $.ajax({
                    headers: { 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') },
                    url: '/slot/history/unconfirm', method: 'POST', dataType: 'JSON', data: { history_ids: ids },
                    success: r => { alert(r.message); if (r.result === 'success') location.reload(); },
                    error: x => { alert('실패했습니다'); console.log(x); }
                });
            }
        });

        $('#btn-confirm-delete').on('click', function () {
            const ids = getCheckedIds();
            if (ids.length < 1) { alert('처리할 내역을 선택해주세요.'); return; }
            if (confirm('선택한 내역 ' + ids.length + '건을 삭제 처리하겠습니까?')) {
                $.ajax({
                    headers: { 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') },
                    url: '/slot/history/delete', method: 'POST', dataType: 'JSON', data: { history_ids: ids },
                    success: r => { alert(r.message); if (r.result === 'success') location.reload(); },
                    error: x => { alert('실패했습니다'); console.log(x); }
                });
            }
        });

        /* ===== 바텀시트 ===== */
        $(function () {
            const $sheet = $('#sheetHistory');
            const $panel = $sheet.find('.dht-sheet__panel');

            function setText(id, v) { $('#' + id).text(v ?? '-'); }
            function fill(d) {
                setText('sheetTitle', d.uname || '-'); setText('sheetSub', d.uid || '-');
                setText('kvDate', d.date || '-'); setText('kvAgency', d.agency || '-'); setText('kvAgencyMemo', d.agencymemo || '-');
                setText('kvKey', d.keyid || '-'); setText('kvMenu', d.menu || '-'); setText('kvMemo', d.memo || '-');
                setText('kvJob', d.job || '-'); setText('kvDays', d.days ?? '0'); setText('kvTask', d.task || '-'); setText('kvCheck', d.check || '-');
                $sheet.data('id', d.id || '');
            }
            function openSheet(d) {
                fill(d); $sheet.removeClass('is-closing').attr('aria-hidden', 'false');
                requestAnimationFrame(() => { $sheet.addClass('is-open'); document.body.classList.add('sheet-open'); });
            }
            function closeSheet() {
                if (!$sheet.hasClass('is-open') || $sheet.hasClass('is-closing')) return;
                $sheet.addClass('is-closing').removeClass('is-open');
                const finish = () => { $panel.off('.sheetEnd'); $sheet.removeClass('is-closing').attr('aria-hidden', 'true'); document.body.classList.remove('sheet-open'); };
                $panel.one('transitionend.sheetEnd webkitTransitionEnd.sheetEnd', e => { if (e.target === $panel[0]) finish(); });
                setTimeout(finish, 450);
            }

            // 카드 본문 클릭 → 상세. 체크박스 클릭은 그대로 유지.
            $(document).on('click', '.agc-card__body', function (e) {
                if ($(e.target).closest('.agc-card__check-wrap').length) return;
                const $t = $(this);
                openSheet({
                    id: $t.data('id'), uname: $t.data('uname'), uid: $t.data('uid'),
                    date: $t.data('date'), agency: $t.data('agency'), agencymemo: $t.data('agencymemo'),
                    keyid: $t.data('keyid'), menu: $t.data('menu'), memo: $t.data('memo'),
                    job: ($t.data('job') === 'N' ? '슬롯생성' : $t.data('job') === 'E' ? '기간연장' : $t.data('job') === 'W' ? '슬롯철회' : $t.data('job')),
                    days: $t.data('days'), task: $t.data('task'), check: $t.data('check')
                });
            });
            $(document).on('click', '.js-sheet-close', closeSheet);
            $sheet.on('click', e => { if ($(e.target).is('.dht-sheet__backdrop')) closeSheet(); });
            $(document).on('keydown', e => { if (e.key === 'Escape' && $sheet.hasClass('is-open')) closeSheet(); });

            // 드래그로 닫기
            let dragging = false, startY = 0, curY = 0;
            function onStart(e) { dragging = true; startY = (e.touches ? e.touches[0].clientY : e.clientY); curY = 0; $panel.css('transition', 'none'); $('html').addClass('no-select'); }
            function onMove(e) { if (!dragging) return; const y = (e.touches ? e.touches[0].clientY : e.clientY) - startY; if (y > 0) { curY = y; $panel.css('transform', `translateY(${y}px)`); } }
            function onEnd() { if (!dragging) return; dragging = false; const h = $panel.outerHeight(); if (curY > h * 0.2 || curY > 100) { $panel.attr('style', ''); closeSheet(); } else { $panel.css('transition', 'transform .2s ease').css('transform', 'translateY(0)'); setTimeout(() => { $panel.attr('style', '') }, 220); } $('html').removeClass('no-select'); }
            $panel.on('mousedown touchstart', onStart); $(window).on('mousemove touchmove', onMove); $(window).on('mouseup touchend', onEnd);
        });

        // 모달 닫힘시 포커스 blur(다른 페이지 공용 스크립트와 합치기 안전용)
        document.addEventListener('hide.bs.modal', function () {
            const ae = document.activeElement; if (ae && typeof ae.blur === 'function') ae.blur();
        });
    </script>



    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ul = document.querySelector('.table-footer .pagination');
            if (!ul) return;

            // 숫자 li에 표준 클래스/데이터 부여
            [...ul.querySelectorAll('li')].forEach(li => {
                const a = li.querySelector('.page-link');
                const t = a ? a.textContent.trim() : '';
                if (/^\d+$/.test(t)) { li.classList.add('page-number'); li.dataset.page = t; }
                if (li.classList.contains('disabled') && t === '...') li.classList.add('page-ellipsis');
            });

            // 모바일 축약 로직
            if (matchMedia('(max-width: 575.98px)').matches) {
                const nums = [...ul.querySelectorAll('.page-number')];
                if (nums.length) {
                    const active = ul.querySelector('.page-item.active .page-link');
                    const cur = active ? parseInt(active.textContent, 10) : NaN;
                    const max = Math.max(...nums.map(li => +li.dataset.page));
                    const keep = new Set([1, max, cur - 1, cur, cur + 1].filter(n => n >= 1 && n <= max));

                    nums.forEach(li => {
                        if (!keep.has(+li.dataset.page)) li.classList.add('is-hide-mobile');
                    });

                    // … 표시 두 군데만 노출
                    ul.querySelectorAll('.page-ellipsis').forEach(el => el.classList.add('is-hide-mobile'));
                    if (Math.min(...keep) > 2) {
                        const firstEllip = ul.querySelector('.page-ellipsis'); if (firstEllip) firstEllip.classList.remove('is-hide-mobile');
                    }
                    if (Math.max(...keep) < max - 1) {
                        const all = ul.querySelectorAll('.page-ellipsis');
                        const lastEllip = all[all.length - 1]; if (lastEllip) lastEllip.classList.remove('is-hide-mobile');
                    }
                }
            }
        });
    </script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ▼ 페이지/컨테이너 스크롤 시 닫고, 드롭다운 내부 스크롤은 유지
            function getScrollParents(el) {
                const out = []; let p = el.parentNode;
                while (p && p !== document.body && p !== document.documentElement) {
                    const s = getComputedStyle(p);
                    if (/(auto|scroll)/.test(s.overflowY) && p.scrollHeight > p.clientHeight) out.push(p);
                    p = p.parentNode;
                }
                out.push(window);
                return out;
            }

            ['sjtype', 'sagency', 'select-limit'].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;

                // 기존 유틸 우선 사용
                if (window.buildCustomSelect) { buildCustomSelect(el); return; }

                var host = document.querySelector('.dht-select[data-target="' + id + '"]');
                if (!host || host.dataset.ready === '1') return;

                el.hidden = true;

                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'dht-select__btn';
                btn.innerHTML = '<span class="dht-select__label"></span><i class="dht-select__caret" aria-hidden="true"></i>';
                host.appendChild(btn);

                var portal = document.createElement('div');
                portal.className = 'dht-sel-portal';
                portal.setAttribute('role', 'listbox');
                document.body.appendChild(portal);

                function render() {
                    portal.innerHTML = '';
                    Array.from(el.options).forEach(function (opt) {
                        var div = document.createElement('div');
                        div.className = 'dht-select__opt';
                        div.textContent = opt.text;
                        div.dataset.value = opt.value;
                        div.setAttribute('role', 'option');
                        if (opt.selected) div.setAttribute('aria-selected', 'true');
                        div.onclick = function () {
                            el.value = opt.value;
                            el.dispatchEvent(new Event('change', { bubbles: true }));
                            sync();
                            closePortal();
                        };
                        portal.appendChild(div);
                    });
                }

                function sync() {
                    var cur = el.selectedOptions[0];
                    btn.querySelector('.dht-select__label').textContent = cur ? cur.text : '선택';
                    portal.querySelectorAll('[aria-selected]').forEach(function (n) { n.removeAttribute('aria-selected'); });
                    var sel = portal.querySelector('.dht-select__opt[data-value="' + el.value + '"]');
                    if (sel) sel.setAttribute('aria-selected', 'true');
                }

                function compute() {
                    var r = btn.getBoundingClientRect(), pad = 8, gap = 6, vw = innerWidth, vh = innerHeight;

                    var width = Math.min(Math.max(r.width, 160), vw - pad * 2);
                    var left = Math.min(Math.max(r.left, pad), vw - pad - width);

                    portal.classList.remove('dir-up');
                    var top = r.bottom + gap;

                    portal.style.width = width + 'px';
                    portal.style.left = left + 'px';
                    portal.style.top = Math.max(pad, top) + 'px';
                    portal.style.maxHeight = '';
                }



                function openPortal() {
                    compute();
                    portal.classList.add('is-open');
                    requestAnimationFrame(() => portal.classList.add('anim'));
                    host.classList.add('is-open');

                    const h = {};
                    h.onDoc = (e) => { if (!portal.contains(e.target) && !btn.contains(e.target)) closePortal(); };
                    h.onKey = (e) => { if (e.key === 'Escape') closePortal(); };
                    h.onResize = () => { if (portal.classList.contains('is-open')) compute(); };

                    h.scrollParents = getScrollParents(btn);
                    h.onParentScroll = (e) => { if (portal.contains(e.target)) return; closePortal(); };

                    portal.addEventListener('scroll', e => e.stopPropagation(), { passive: true });
                    portal.addEventListener('wheel', e => e.stopPropagation(), { passive: true });
                    portal.addEventListener('touchmove', e => e.stopPropagation(), { passive: true });

                    document.addEventListener('click', h.onDoc, true);
                    document.addEventListener('keydown', h.onKey);
                    window.addEventListener('resize', h.onResize);
                    h.scrollParents.forEach(n => n.addEventListener('scroll', h.onParentScroll, { capture: true, passive: true }));

                    portal._h = h;
                }

                function closePortal() {
                    if (!portal.classList.contains('is-open')) return;
                    portal.classList.remove('anim');
                    portal.addEventListener('transitionend', () => portal.classList.remove('is-open'), { once: true });
                    host.classList.remove('is-open');

                    const h = portal._h || {};
                    document.removeEventListener('click', h.onDoc, true);
                    document.removeEventListener('keydown', h.onKey);
                    window.removeEventListener('resize', h.onResize);
                    (h.scrollParents || []).forEach(n => n.removeEventListener('scroll', h.onParentScroll, { capture: true }));

                    portal._h = null;
                }

                btn.onclick = function (e) {
                    e.stopPropagation();
                    if (portal.classList.contains('is-open')) closePortal();
                    else openPortal();
                };

                el.addEventListener('change', sync);
                render(); sync(); host.dataset.ready = '1';
            });
        });
    </script>






    <script>
        (function () {
            function collapse() {
                const pager = document.getElementById('pager');
                if (!pager) return;

                const isMobile = window.matchMedia('(max-width: 575.98px)').matches;
                const items = pager.querySelectorAll('.page-item');
                items.forEach(li => li.classList.remove('is-hidden'));

                if (!isMobile) return; 

                const pages = [...pager.querySelectorAll('.page-number')];
                if (pages.length === 0) return;

                const active = pager.querySelector('.page-number.active');
                const cur = active ? Number(active.dataset.page) : NaN;
                const first = pages[0], last = pages[pages.length - 1];

                const mustShow = new Set([first, last, active]);
                const next = pager.querySelector(`.page-number[data-page="${cur + 1}"]`);
                if (next) mustShow.add(next);

                pages.forEach(li => { if (!mustShow.has(li)) li.classList.add('is-hidden'); });

                const all = [...pager.children];
                let hiddenRun = [];
                all.forEach((li, i) => {
                    const isNum = li.classList.contains('page-number');
                    const hidden = isNum && li.classList.contains('is-hidden');
                    if (hidden) hiddenRun.push(li);
                    if (!hidden || i === all.length - 1) {
                        if (hiddenRun.length) {
                            hiddenRun.forEach(h => h.style.display = 'none');
                            const ell = document.createElement('li');
                            ell.className = 'page-item page-ellipsis';
                            ell.innerHTML = '<span class="page-link">…</span>';
                            hiddenRun[0].before(ell);
                            hiddenRun = [];
                        }
                    }
                });
            }

            window.addEventListener('load', collapse);
            window.addEventListener('resize', () => {
                const pager = document.getElementById('pager');
                if (pager) {
                    pager.querySelectorAll('.is-hidden').forEach(n => n.classList.remove('is-hidden'));
                    pager.querySelectorAll('.page-ellipsis').forEach(n => n.remove());
                    pager.querySelectorAll('.page-number').forEach(n => n.style.removeProperty('display'));
                }
                collapse();
            });
        })();
    </script>


    <script>
        document.getElementById('select-limit')?.addEventListener('change', function () {
            document.getElementById('limit').value = this.value;
            document.getElementById('form-search').submit();
        });
    </script>




