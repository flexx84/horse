                    const html = list.length ? list.map(it => {
                        const d = it.history_date_txt || '';
                        const rank = it.ranking_txt ?? it.ranking ?? '';
                        const diff = Number(it.ranking_change || 0);
                        const sign = diff > 0 ? `+${diff}` : diff < 0 ? `${diff}` : '';
                        const cls = diff > 0 ? 'text-success' : diff < 0 ? 'text-danger' : 'text-muted';
                        return `
                      <tr class="rh-row">
                        <td class="rh-left">
                          <div class="rh-date">${d}</div>
                          <div class="rh-rank"><strong>${rank}</strong></div>
                        </td>
                        <td class="rh-right ${cls}">${sign}</td>
                      </tr>`;
                    }).join('') : '<tr><td class="text-muted">기록 없음</td><td></td></tr>';

                    $tb.html(html);
