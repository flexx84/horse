            if (!$memoT.is(':focus')) $memoT.val('');
            $tb.empty();

            // 먼저 모달 띄움(애니메이션 끊김 방지)
            modalRank.show();

            // 데이터 로드
            $.ajax({ url: '/slot/detail-history/' + id, method: 'GET', dataType: 'json' })
                .done(function (r) {
                    const ok = String(r?.result || '').toLowerCase() === 'success';
                    const slot = r?.slot || {};
                    const list = Array.isArray(r?.history) ? r.history : [];

                    // 타이틀, 메모 기본값
