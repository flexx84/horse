        // 시간별 순위 버튼 핸들러
        $(document).on('click', '.btn-hourly', function () {
            const id = $(this).data('id');
            const $dlg = $('#modal-hourly-rank');
            const $list = $dlg.find('#hrList');
            $dlg.find('#hrKeyword').text('시간별 순위');
            $list.empty();
            modalHourly && modalHourly.show();

            $.getJSON('/slot/detail-hourly/' + id)
                .done(function (res) {
                    const data = res && res.data ? res.data : { items: [] };
                    if (data.keyword) {
                        $dlg.find('#hrKeyword').text(data.keyword + ' - 시간별 순위');
                    }
                    if (!data.items || !data.items.length) {
                        $list.html('<div class="text-muted">데이터가 없습니다.</div>');
                        return;
                    }
                    // 최신이 상단이므로, 상승/하락은 바로 다음(더 오래된) 항목과 비교
                    const items = data.items.slice(); // newest-first
                    const frag = document.createDocumentFragment();
                    for (let i = 0; i < items.length; i++) {
                        const cur = items[i];
                        const next = items[i + 1]; // older
                        const hourTxt = cur.time_txt || '--:--';
                        const rankNum = (cur.ranking && cur.ranking > 0) ? cur.ranking : null;
                        const rankTxt = (typeof cur.ranking_txt === 'string' && cur.ranking_txt.length)
                            ? cur.ranking_txt
                            : (rankNum ? (rankNum + '위') : '-');

                        let deltaClass = 'hr-delta--flat';
                        let deltaTxt = '변화없음';
                        if (next && rankNum !== null) {
                            const nextRank = (next.ranking && next.ranking > 0) ? next.ranking : null;
                            if (nextRank !== null) {
                                const diff = nextRank - rankNum; // 양수면 상승(+)
                                if (diff > 0) { deltaClass = 'hr-delta--up'; deltaTxt = '+' + diff; }
                                else if (diff < 0) { deltaClass = 'hr-delta--down'; deltaTxt = String(diff); }
                                else { deltaClass = 'hr-delta--flat'; deltaTxt = '변화없음'; }
                            } else {
                                deltaClass = 'hr-delta--flat';
                                deltaTxt = '-';
                            }
                        } else if (!next) {
                            // 가장 오래된 항목은 비교 대상 없음
                            deltaClass = 'hr-delta--flat';
                            deltaTxt = '-';
                        }

                        const div = document.createElement('div');
                        div.className = 'hr-item';
                        div.innerHTML = '<div class="hr-time">' + hourTxt + '</div>' +
                                        '<div class="hr-rank">' + rankTxt + '</div>' +
                                        '<div class="hr-delta ' + deltaClass + '">' + deltaTxt + '</div>';
                        frag.appendChild(div);
                    }
                    $list[0].appendChild(frag);
                })
                .fail(function () {
                    $list.html('<div class="text-danger">불러오기에 실패했습니다.</div>');
                });
        });

        // === 메모 저장(중복 알림 차단) ===
        $(document).on('click.rhist', '#btn-update-memo', function (e) {
