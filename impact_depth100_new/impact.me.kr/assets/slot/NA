                data: { id, memo, slot_id: id, comment: memo }
            })
                .done(function (r) {
                    const ok = String(r?.result || '').toLowerCase() === 'success' || r?.success === true || r?.code === 0;
                    alert(ok ? (r?.message || '메모가 저장되었습니다.') : (r?.message || '메모 저장 실패'));
                })
                .fail(function () { alert('요청 실패'); });
        });
    </script>







