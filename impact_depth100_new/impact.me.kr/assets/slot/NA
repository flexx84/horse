    <script>
        (() => {
            const bar = document.getElementById('selection-bar');
            const surf = document.getElementById('sbSurface');
            const countEl = document.getElementById('sbCount');
            const clearBtn = document.getElementById('sbClear');
            const master = document.getElementById('select-all');
            const rowSel = 'input[type="checkbox"][name="check-slot-list[]"]';
            if (!bar || !surf || !countEl) return;

            const header = document.querySelector('.main-header, header.navbar, .app-header, .page-header') || null;
            function setHdrH() {
                const h = header ? header.getBoundingClientRect().height : 80;
                document.documentElement.style.setProperty('--hdr-h', `${Math.round(h)}px`);
            }
            setHdrH();
            new ResizeObserver(setHdrH).observe(document.documentElement);
            header && new ResizeObserver(setHdrH).observe(header);

            function setSbH() {
                const h = surf.scrollHeight;
                const gap = 12;
                document.documentElement.style.setProperty('--sb-h', `${Math.ceil(h + gap)}px`);
            }
            new ResizeObserver(setSbH).observe(surf);
            window.addEventListener('resize', setSbH);

            const sentry = document.createElement('div');
            sentry.style.position = 'absolute';
            sentry.style.top = '0'; sentry.style.height = '1px';
            bar.prepend(sentry);
            new IntersectionObserver(([e]) => {
                bar.classList.toggle('is-stuck', !e.isIntersecting);
            }, { rootMargin: `-${getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')} 0px 0px 0px`, threshold: 1 })
                .observe(sentry);

            const actionBtnIds = ['btn-modal-extend', 'btn-modal-max-click', 'btn-modal-setting-count', 'btn-modal-init', 'btn-modal-delete-select'];
            const actionBtns = actionBtnIds.map(id => document.getElementById(id)).filter(Boolean);
            const selected = new Set();
            const getRows = () => Array.from(document.querySelectorAll(rowSel));

            function setOpen(open) {
                bar.classList.toggle('is-open', open);
                bar.setAttribute('aria-hidden', open ? 'false' : 'true');
                if (open) { setSbH(); ensureVisible(); }
            }

            function ensureVisible() {
                const r = bar.getBoundingClientRect();
                const hdrH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')) || 56;
                const above = r.top < hdrH || r.bottom < hdrH;
                const below = r.top > window.innerHeight;
                if (above || below) { bar.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            }

            function render() {
                const n = selected.size;
                countEl.textContent = n;
                setOpen(n > 0);
                actionBtns.forEach(b => b.disabled = n === 0);

                if (master) {
                    const rows = getRows();
                    const checked = rows.filter(c => c.checked).length;
                    master.checked = rows.length > 0 && checked === rows.length;
                    master.indeterminate = checked > 0 && checked < rows.length;
                }
            }

            function syncFromDOM() {
                selected.clear();
                getRows().forEach(c => { if (c.checked) selected.add(c.value); });
                render();
            }

            document.readyState === 'loading'
                ? document.addEventListener('DOMContentLoaded', syncFromDOM)
                : syncFromDOM();

            document.addEventListener('change', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLInputElement)) return;

                if (t === master) {
                    const on = !!t.checked;
                    getRows().forEach(c => { c.checked = on; on ? selected.add(c.value) : selected.delete(c.value); });
                    render();
                    return;
                }
                if (t.matches(rowSel)) {
                    t.checked ? selected.add(t.value) : selected.delete(t.value);
                    render();
                }
            });

            clearBtn?.addEventListener('click', () => {
                selected.clear();
                getRows().forEach(c => c.checked = false);
                render();
            });

            window.getSelectedSlotIds = () => Array.from(selected);
        })();
    </script>


    <script>
        (() => {
            const native = document.getElementById('select-limit');
            const wrap = document.getElementById('dhtLimit');
            if (!native || !wrap) return;

            const btn = document.getElementById('dhtLimitBtn');
            const list = document.getElementById('dhtLimitList');
            const label = wrap.querySelector('.dht-select__label');
            const hiddenLimit = document.getElementById('limit');
            const form = document.getElementById('form-search');

            const opts = Array.from(native.options).map(o => ({ val: o.value, text: o.text, sel: o.selected }));
            list.innerHTML = opts.map(o => `<li role="option" class="dht-select__opt" data-val="${o.val}" aria-selected="${o.sel ? 'true' : 'false'}">${o.text}</li>`).join('');
            const items = Array.from(list.querySelectorAll('.dht-select__opt'));
            const cur = opts.find(o => o.sel) || opts[0];
            label.textContent = cur.text;

            function open() { wrap.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); setActive(indexOfSel()); list.focus(); bindDoc(); }
            function close() { wrap.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); items.forEach(i => i.classList.remove('is-active')); unbindDoc(); }
            function toggle() { wrap.classList.contains('is-open') ? close() : open(); }
            function indexOfSel() { return items.findIndex(el => el.getAttribute('aria-selected') === 'true'); }
            function setActive(i) { const idx = Math.max(0, Math.min(items.length - 1, i)); items.forEach(x => x.classList.remove('is-active')); items[idx]?.classList.add('is-active'); items[idx]?.scrollIntoView({ block: 'nearest' }); }

            function choose(el) {
                const val = el.dataset.val, txt = el.textContent.trim();
                items.forEach(i => i.setAttribute('aria-selected', i === el ? 'true' : 'false'));
                label.textContent = txt;
                native.value = val;
                if (hiddenLimit) hiddenLimit.value = val;
                if (form) form.submit();
            }

            function onDoc(e) { if (!wrap.contains(e.target)) close(); }
            function onKey(e) {
                if (!wrap.classList.contains('is-open')) return;
                const idx = items.findIndex(x => x.classList.contains('is-active'));
                if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(items.length - 1, idx + 1)); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(0, idx - 1)); }
                else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
                else if (e.key === 'End') { e.preventDefault(); setActive(items.length - 1); }
                else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); const el = items.find(x => x.classList.contains('is-active')) || items[0]; if (el) { choose(el); close(); btn.focus(); } }
                else if (e.key === 'Escape') { e.preventDefault(); close(); btn.focus(); }
            }
            function bindDoc() { document.addEventListener('click', onDoc); document.addEventListener('keydown', onKey); }
            function unbindDoc() { document.removeEventListener('click', onDoc); document.removeEventListener('keydown', onKey); }

            // 이벤트
            btn.addEventListener('click', toggle);
            btn.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') { e.preventDefault(); open(); }
            });
            items.forEach((el, i) => {
                el.addEventListener('mousemove', () => setActive(i));
                el.addEventListener('click', () => { choose(el); close(); btn.focus(); });
            });

            // 네이티브 변경과도 동기화(방어)
            native.addEventListener('change', () => {
                const o = native.options[native.selectedIndex]; if (!o) return;
                const el = items.find(x => x.dataset.val === o.value); if (el) choose(el);
            });
        })();
    </script>


    <script>
        (function ($) {
            let $openCell = null, $menu = null, anchorBtn = null, locked = false;
            const Z = 1035;

            function mountKebab() {
                $('.mrx-td--menu').each(function () {
                    const $cell = $(this);
                    if ($cell.data('kebab-init')) return;
                    $cell.data('kebab-init', 1);
                    if ($cell.find('button.mrx-kebab').length === 0) {
                        $cell.append('<button type="button" class="mrx-kebab" aria-label="메뉴"></button>');
                    }
                    if (!$cell.data('menu')) {
                        $cell.data('menu', $('<div class="mrx-menu" role="menu" aria-hidden="true"></div>'));
                    }
                });
            }

            function positionMenu(btn) {
                const r = btn.getBoundingClientRect();
                $menu.css({ left: Math.round(r.left + (r.width / 2) - ($menu.outerWidth() / 2)), top: Math.round(r.bottom + 8) });
            }

            function openMenu($cell, btn) {
                $menu = $cell.data('menu');
                // 현재 locked 상태에 맞춰 즉시 렌더
                renderMenu($cell);

                $menu.appendTo(document.body)
                    .attr('data-portal', '1')
                    .css({ position: 'fixed', display: 'block', visibility: 'hidden', zIndex: Z });
                anchorBtn = btn;
                positionMenu(btn);
                $menu.css({ visibility: 'visible' });
                $openCell = $cell;
            }

            function closeMenu(force) {
                if (!$menu) return;
                if (locked && !force) return;
                $menu.hide().removeAttr('data-portal').appendTo($openCell);
                $menu = null; $openCell = null; anchorBtn = null;
            }

            function renderMenu($cell) {
                const isThisLocked = locked && $openCell && $openCell[0] === $cell[0];
                const html = isThisLocked
                    ? '<button type="button" class="mrx-menu__item js-act" data-act="confirm">확인</button>\
                     <button type="button" class="mrx-menu__item js-act" data-act="cancel">취소</button>'
                    : '<button type="button" class="mrx-menu__item js-act" data-act="edit">수정</button>'
                    + ($cell.find('.btn-modal-delete').length ? '<button type="button" class="mrx-menu__item js-act" data-act="delete">삭제</button>' : '');
                $cell.data('menu').html(html);
            }

            // 케밥 토글
            $(document).on('click', '.mrx-td--menu .mrx-kebab', function (e) {
                e.stopPropagation();
                const $cell = $(this).closest('.mrx-td--menu');
                if (locked) return;
                if ($openCell && $openCell[0] === $cell[0]) { closeMenu(true); return; }
                closeMenu(true);
                openMenu($cell, this);
            });

            // 메뉴 동작
            $(document).on('click', '.mrx-menu[data-portal="1"] .js-act', function (e) {
                e.preventDefault(); e.stopPropagation();
                if (!$openCell) return;
                const act = $(this).data('act');

                if (act === 'edit') {
                    // 1) 먼저 상태 고정
                    locked = true;
                    // 2) 드롭다운을 즉시 확인/취소로 교체
                    renderMenu($openCell);
                    positionMenu(anchorBtn);
                    // 3) 기존 "수정" 버튼 로직 호출
                    $openCell.find('.btn-modal-edit').trigger('click');
                    return;
                }
                if (act === 'confirm') {
                    window.__mrxPending = 'confirm';
                    // 잠깐 비활성화(중복 클릭 방지)
                    $(this).prop('disabled', true);
                    $openCell.find('.btn-modal-confirm').trigger('click');
                    // 닫지 않음. 결과는 ajaxComplete에서 판단
                    return;
                }
                if (act === 'cancel') {
                    $openCell.find('.btn-modal-cancel').trigger('click');
                    locked = false; closeMenu(true); return;
                }
                if (act === 'delete') {
                    $openCell.find('.btn-modal-delete').trigger('click');
                    closeMenu(true); return;
                }
            });

            // 외부 클릭/모달/스크롤
            $(document).on('click', function () { closeMenu(false); });
            $(document).on('click', '.mrx-menu[data-portal="1"]', function (e) { e.stopPropagation(); });
            $(document).on('show.bs.modal shown.bs.offcanvas', function () { closeMenu(true); });

            let raf = null;
            function onScrollResize() {
                if (!$openCell) return;
                if (locked) {
                    if (!raf) raf = requestAnimationFrame(() => { raf = null; positionMenu(anchorBtn); });
                } else {
                    closeMenu(true);
                }
            }
            $(window).on('scroll resize', onScrollResize);

            // Ajax 확인 성공 후 필요 시 외부에서 닫기
            window.MRXKebab = { close: () => { locked = false; closeMenu(true); } };

            $(function () { mountKebab(); });
        })(jQuery);

    </script>


    <script>
        (function () {
            function outsideCloseFactory(wrap, close) { return (e) => { if (!wrap.contains(e.target)) close(); }; }
            function setNativeValue(el, val) {
                if (!el) return;
                el.value = val;
                const ev = new Event('change', { bubbles: true });
                el.dispatchEvent(ev);
            }

            const userWrap = document.getElementById('ui-slot-user');
            if (userWrap) {
                const native = document.getElementById(userWrap.dataset.target);
                const btn = userWrap.querySelector('.dht-select__btn');
                const label = userWrap.querySelector('.dht-select__label');
                const panel = userWrap.querySelector('.dht-select__panel');
                const ipt = userWrap.querySelector('.dht-select__input');
                const list = userWrap.querySelector('.dht-select__list');

                function setLabel(txt) { label.textContent = txt || '회원 검색'; }
                function open() { userWrap.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); ipt.focus(); }
                function close() { userWrap.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
                const onDocUser = outsideCloseFactory(userWrap, close);

                btn.addEventListener('click', (e) => { e.preventDefault(); userWrap.classList.contains('is-open') ? close() : open(); });
                document.addEventListener('click', onDocUser);

                async function fetchUsers(q) {
                    const r = await fetch(`/member/search?q=${encodeURIComponent(q || '')}`);
                    const data = await r.json();
                    return Array.isArray(data) ? data : (data.items || data.results || []);
                }

                let curIdx = -1, items = [];
                function render(rows) {
                    list.innerHTML = rows.map(o => `<li class="dht-select__opt" role="option" data-val="${o.id}">${o.text}</li>`).join('');
                    items = Array.from(list.children);
                    curIdx = items.length ? 0 : -1;
                    if (curIdx >= 0) items[curIdx].classList.add('is-active');
                }

                let t = null;
                ipt.addEventListener('input', () => {
                    clearTimeout(t);
                    t = setTimeout(async () => {
                        const rows = await fetchUsers(ipt.value.trim());
                        render(rows);
                    }, 120);
                });

                function setActive(i) {
                    if (i < 0 || i >= items.length) return;
                    items[curIdx]?.classList.remove('is-active');
                    curIdx = i; items[curIdx].classList.add('is-active');
                    items[curIdx].scrollIntoView({ block: 'nearest' });
                }
                function move(d) { if (items.length) setActive(Math.max(0, Math.min(items.length - 1, curIdx + d))); }

                function choose(li) {
                    if (!li) return;
                    const val = li.dataset.val, txt = li.textContent.trim();
                    // 선택한 값의 option이 없으면 추가
                    const existingOption = Array.from(native.options).find(opt => opt.value === val);
                    if (!existingOption) {
                        const newOption = document.createElement('option');
                        newOption.value = val;
                        newOption.text = txt;
                        native.appendChild(newOption);
                    }
                    setNativeValue(native, val);
                    setLabel(txt); close(); btn.focus();
                }

                list.addEventListener('click', (e) => {
                    const li = e.target.closest('.dht-select__opt'); if (li) choose(li);
                });
                [list, ipt].forEach(el => el.addEventListener('keydown', (e) => {
                    if (!userWrap.classList.contains('is-open')) return;
                    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
                    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
                    else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
                    else if (e.key === 'End') { e.preventDefault(); setActive(items.length - 1); }
                    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(items[curIdx]); }
                    else if (e.key === 'Escape') { e.preventDefault(); close(); btn.focus(); }
                }));

                (async () => {
                    setLabel(native.options[native.selectedIndex]?.text || '회원 검색');
                    const rows = await fetchUsers('');
                    render(rows);
                })();
            }

            const daysWrap = document.getElementById('ui-slot-days');
            if (daysWrap) {
                const native = document.getElementById(daysWrap.dataset.target); // #add-slot-date
                const btn = daysWrap.querySelector('.dht-select__btn');
                const label = daysWrap.querySelector('.dht-select__label');
                const panel = daysWrap.querySelector('.dht-select__panel');
                const opts = Array.from(daysWrap.querySelectorAll('.dht-select__opt'));
                const directIpt = document.getElementById('add-slot-date2');

                function open() { daysWrap.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
                function close() { daysWrap.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
                const onDocDays = outsideCloseFactory(daysWrap, close);

                function choose(el) {
                    const val = el.dataset.val, txt = el.textContent.trim();
                    label.textContent = txt;
                    opts.forEach(o => o.setAttribute('aria-selected', o === el ? 'true' : 'false'));
                    setNativeValue(native, val);
                    const direct = val === '0';
                    directIpt.disabled = !direct;
                    if (!direct) directIpt.value = '';
                    close();
                }

                btn.addEventListener('click', (e) => { e.preventDefault(); daysWrap.classList.contains('is-open') ? close() : open(); });
                document.addEventListener('click', onDocDays);
                opts.forEach(o => o.addEventListener('click', () => choose(o)));

                const init = opts.find(o => o.dataset.val === native.value) || opts[0];
                if (init) choose(init);
            }

            (() => {
                const chk = document.getElementById('add-slot-today');
                if (!chk) return;
                const box = chk.parentElement.querySelector('.dht-roundcheck__box');
                if (box) {
                    chk.parentElement.addEventListener('click', (e) => {
                        if (e.target === chk) return;
                        e.preventDefault();
                        chk.checked = !chk.checked;
                    });
                }
            })();

            window.addEventListener('DOMContentLoaded', () => {
                const openBtn = document.getElementById('btn-modal-add');
                const form = document.getElementById('form-slot-add');
                if (openBtn) {
                    openBtn.addEventListener('click', () => {
                        form && form.reset();
                        setNativeValue(document.getElementById('add-slot-date'), '10');
                        const lbl = document.querySelector('#ui-slot-days .dht-select__label');
                        if (lbl) lbl.textContent = '10일';
                        const ipt = document.getElementById('add-slot-date2');
                        if (ipt) { ipt.value = ''; ipt.disabled = true; }
                        const ulab = document.querySelector('#ui-slot-user .dht-select__label');
                        if (ulab) ulab.textContent = '회원 검색';
                    });
                }
            });
        })();
    </script>


