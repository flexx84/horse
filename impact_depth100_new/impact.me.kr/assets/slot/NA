            $(document).off('click.mxsClose').on('click.mxsClose', '.mxs-backdrop, .js-mxs-close', closeSheet);
            $(document).off('keydown.mxsEsc').on('keydown.mxsEsc', e => { if (e.key === 'Escape' && $sheet.hasClass('is-open')) closeSheet(); });

            /* ===== 드래그 닫기: 액션바/버튼 제외 + 8px 임계 ===== */
            let dragging = false, active = false, startY = 0, curY = 0, allowDrag = false;
            const THRESH = 8;

            const hasInnerScroll = () => { const el = $body[0]; return el && el.scrollHeight > el.clientHeight; };
            const isInteractive = (t) => {
                if (!t) return false;
                if (t.closest('.mxs-actions')) return true;          // 하단 버튼 영역
                if (t.closest('.dht-sheet__actions')) return true;   // 혹시 공용 클래스
                const tag = t.tagName;
                return /BUTTON|A|INPUT|TEXTAREA|SELECT|LABEL/.test(tag);
            };

            function onStart(e) {
                const oe = e.originalEvent || e;
                const target = e.target;

                // 액션바·버튼 클릭은 드래그 금지
                if (isInteractive(target)) { dragging = false; active = false; return; }

                const startedOnHeader = $header.is(target) || $header.has(target).length > 0;
                allowDrag = hasInnerScroll() ? startedOnHeader : true;
                if (!allowDrag) return;

                dragging = true; active = false;
                startY = (oe.touches ? oe.touches[0].clientY : oe.clientY);
                curY = 0;
                $panel.css('transition', 'none');
                document.documentElement.classList.add('no-select');
            }

            function onMoveNative(e) {
                if (!dragging) return;
                const oe = e.originalEvent || e;

                const y = (oe.touches ? oe.touches[0].clientY : oe.clientY) - startY;
                if (!active) {
                    // 수직 이동이 임계 넘을 때부터 드래그로 간주
                    if (y > THRESH) active = true;
                    else return; // 아직 클릭 제스처로 간주
                }

                // 활성 드래그 상태에서는 페이지 스크롤 차단
                if (oe.cancelable) oe.preventDefault();

                if (y > 0) {
                    curY = y;
                    $panel.css('transform', `translateY(${y}px)`);
                }
            }

            function onEnd() {
                if (!dragging) return;
                dragging = false;

                // 활성 드래그 아니면 클릭으로 처리(액션 버튼 동작 보장)
                if (!active) {
                    document.documentElement.classList.remove('no-select');
                    $panel.attr('style', ''); // transition 초기화
                    return;
                }

                active = false;
                const h = $panel.outerHeight();
                if (curY > h * 0.2 || curY > 100) { $panel.attr('style', ''); closeSheet(); }
                else {
                    $panel.css('transition', 'transform .2s ease').css('transform', 'translateY(0)');
                    setTimeout(() => $panel.attr('style', ''), 220);
                }
                document.documentElement.classList.remove('no-select');
            }

            // 바인딩(네이티브 + passive:false)
            $panel.off('mousedown.mxs touchstart.mxs').on('mousedown.mxs touchstart.mxs', onStart);
            window.removeEventListener('touchmove', onMoveNative, { passive: false });
            window.removeEventListener('mousemove', onMoveNative);
            window.addEventListener('touchmove', onMoveNative, { passive: false });
            window.addEventListener('mousemove', onMoveNative);
            $(window).off('mouseup.mxs touchend.mxs touchcancel.mxs').on('mouseup.mxs touchend.mxs touchcancel.mxs', onEnd);

        })();
    </script>











    <script>
        (() => {
            const $sheet = $('#mxsSlot');
            const $panel = $sheet.find('.mxs-panel');
            const $actions = $sheet.find('.mxs-actions');

            // 표시용 요소 캐시
            const $v = {
                id: $('#mxvId'),
                keyword: $('#mxvKeyword'),
                rankkw: $('#mxvRankKeyword'),
                urlA: $('#mxvUrlA'),
                mid: $('#mxvMid'),
                mid2: $('#mxvMid2'),
                memo: $('#mxvMemo'),
            };

            // 편집용 입력 동적 생성(최초 1회)
            let inited = false;
            function ensureEditors() {
                if (inited) return; inited = true;

                function mkInput(afterEl, id, type = 'text') {
                    if (!afterEl?.length) return null;
                    const $ipt = $(`<input type="${type}" id="${id}" class="form-control mxs-edit mrx-input" hidden>`);
                    afterEl.after($ipt);
                    return $ipt;
                }

                function mkTextarea(afterEl, id) {
                    if (!afterEl?.length) return null;
                    const $textarea = $(`<textarea id="${id}" class="form-control mxs-edit mrx-input" rows="4" style="resize: vertical; min-height: 100px;" hidden></textarea>`);
                    afterEl.after($textarea);
                    return $textarea;
                }

                // 표시 요소 바로 뒤에 대응 입력 생성
                mkInput($v.keyword, 'mxeKeyword');
                mkInput($v.rankkw, 'mxeRankKeyword');
                if ($v.urlA.length) mkInput($v.urlA.closest('.mxs-v'), 'mxeUrl'); // 링크는 a 대신 div에 입력 생성
                if ($v.mid.length) mkInput($v.mid, 'mxeMid');
                if ($v.mid2.length) mkInput($v.mid2, 'mxeMid2');
                if ($v.memo.length) mkTextarea($v.memo, 'mxeMemo');
            }

            // 편집모드 토글
            let EDIT = false;
            function setMode(edit) {
                EDIT = edit;
                ensureEditors();

                // 버튼 토글
                $actions.find('.js-mxs-close, .js-mxs-delete, .js-mxs-edit').prop('hidden', edit);
                $actions.find('.js-mxs-confirm, .js-mxs-cancel').prop('hidden', !edit);

                // 표시/입력 토글 + 값 동기화
                function showPair($view, iptId, valGetter, valSetter) {
                    if (!$view?.length || !document.getElementById(iptId)) return;
                    const $ipt = $('#' + iptId);
                    if (edit) {
                        const cur = (valGetter && valGetter()) ?? $view.text().trim();
                        $ipt.val(cur).prop('hidden', false);
                        $view.prop('hidden', true);
                    } else {
                        const nv = $ipt.val().trim();
                        if (valSetter) valSetter(nv); else $view.text(nv || '-');
                        $ipt.prop('hidden', true);
                        $view.prop('hidden', false);
                    }
                }

                // 키워드
                showPair($v.keyword, 'mxeKeyword');
                // 순위키워드
                showPair($v.rankkw, 'mxeRankKeyword');
                // URL(a 링크)
                if ($v.urlA.length) {
                    const $urlWrap = $v.urlA.closest('.mxs-v');
                    showPair($urlWrap, 'mxeUrl',
                        () => $v.urlA.text().trim(),
                        (nv) => {
                            const u = nv ? (/^https?:\/\//.test(nv) ? nv : 'https://' + nv) : '#';
                            $v.urlA.text(nv || '-').attr('href', u);
                        });
                }
                // MID/MID2
                if ($v.mid.length) showPair($v.mid, 'mxeMid');
                if ($v.mid2.length) showPair($v.mid2, 'mxeMid2');
                // 메모
                if ($v.memo.length) showPair($v.memo, 'mxeMemo');
            }

            // 편집 시작
            $(document).off('click.mxsEdit').on('click.mxsEdit', '.js-mxs-edit', function () {
                setMode(true);
            });

            // 시트 닫힌 후 모달 오픈
            $(document).off('click.mxsDelOpen')
                .on('click.mxsDelOpen', '#mxsSlot .js-mxs-delete', async function (e) {
                    e.preventDefault(); e.stopPropagation();

                    const id = ($sheet.data('id') || '').toString();
                    if (!id) { alert('ID 누락'); return; }
                    $('#delete-slot-id').val(id);

                    // 바텀시트 닫힘 완료 대기
                    await new Promise((resolve) => {
                        if (!$sheet.hasClass('is-open')) return resolve();
                        const done = () => {
                            $sheet.attr('aria-hidden', 'true').removeClass('is-closing');
                            resolve();
                        };
                        $sheet.addClass('is-closing').removeClass('is-open');
                        $panel.one('transitionend.mxsDel webkitTransitionEnd.mxsDel', (ev) => {
                            if (ev.target === $panel[0]) done();
                        });
                        setTimeout(done, 450); // 폴백
                    });

                    // 모달 열기
                    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                        $('#modal-slot-delete').modal('show');
                    } else {
                        document.getElementById('modal-slot-delete')?.classList.add('show');
                    }
                });



            // 취소
            $(document).off('click.mxsCancel').on('click.mxsCancel', '.js-mxs-cancel', function () {
                setMode(false); // 뷰로 되돌림(입력값은 적용 안 함)
            });

            // 확인 → 서버 반영
            $(document).off('click.mxsConfirm').on('click.mxsConfirm', '.js-mxs-confirm', function () {
                const id = ($sheet.data('id') || '').toString().trim();
                if (!id) { alert('ID 누락'); return; }

                // 기존 인라인 API 규격 재사용
                const data = {
                    slot_id: id,
                    slot_keyword: $('#mxeKeyword').val()?.trim(),
                    slot_rankkeyword: $('#mxeRankKeyword').val()?.trim()
                };

                // 메뉴별 필드 존재 시만 포함
                const $mxeUrl = $('#mxeUrl'); if ($mxeUrl.length) data.slot_url = $mxeUrl.val()?.trim();
                const $mxeMid = $('#mxeMid'); if ($mxeMid.length) data.slot_mid = $mxeMid.val()?.trim();
                const $mxeMid2 = $('#mxeMid2'); if ($mxeMid2.length) data.slot_mid2 = $mxeMid2.val()?.trim();
                const $mxeMemo = $('#mxeMemo'); if ($mxeMemo.length) data.slot_memo = $mxeMemo.val()?.trim();

                $.ajax({
                    headers: { 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') },
                    url: '/slot/set-inline', method: 'POST', dataType: 'json', data
                })
                    .done(r => {
                        const ok = String(r?.result || '').toLowerCase() === 'success';
                        if (!ok) { alert(r?.message || '저장 실패'); return; }

                        // 시트 뷰 갱신(입력→표시로 반영)
                        setMode(false);

                        // 목록 카드 데이터도 동기화(열려있는 카드만)
                        const $card = $(`.mxc-card[data-id="${id}"]`);
                        if ($card.length) {
                            if (data.slot_keyword) $card.attr('data-keyword', data.slot_keyword);
                            if (data.slot_rankkeyword) $card.attr('data-rankkeyword', data.slot_rankkeyword);
                            if (data.slot_url) $card.attr('data-url', data.slot_url);
                            if (data.slot_mid) $card.attr('data-mid', data.slot_mid);
                            if (data.slot_mid2) $card.attr('data-mid2', data.slot_mid2);
                            if (data.slot_memo !== undefined) $card.attr('data-memo', data.slot_memo);
                            // 카드 타이틀도 최신값으로
                            const title = data.slot_rankkeyword || data.slot_keyword;
                            if (title) $card.find('.mxc-title').text(title);
                        }

                        alert(r?.message || '저장되었습니다.');
                    })
                    .fail(() => alert('요청 실패'));
            });

            // 바텀시트 열릴 때는 항상 보기 모드로
            $(document).off('mxsOpenGuard').on('click.mxsOpenGuard', '.mxc-card .js-mxc-open', () => setMode(false));
            $(document).off('click.mxsDel').on('click.mxsDel', '.js-mxs-delete', () => setMode(false));
        })();
    </script>


    <script>
        // 시트 닫힌 뒤 콜백 실행
        function afterSheetClose(cb) {
            const $sheet = $('#mxsSlot'), $panel = $sheet.find('.mxs-panel');
            if (!$sheet.hasClass('is-open')) { cb(); return; }
            const done = () => { $panel.off('.mxsAfter'); cb(); };
            $panel.on('transitionend.mxsAfter webkitTransitionEnd.mxsAfter', e => {
                if (e.target === $panel[0]) done();
            });
            $sheet.removeClass('is-open').addClass('is-closing');
            setTimeout(() => { $sheet.removeClass('is-closing').attr('aria-hidden', 'true'); }, 360);
        }

        // 랭크 모달 로더(PC와 동일 처리)
        function openRankModal(id) {
            if (!id) { alert('ID 누락'); return; }
            const $dlg = $('#modal-rank-history');
            // 즉시 열기
            if (typeof modalRank !== 'undefined') modalRank.show();
            else $dlg.modal && $dlg.modal('show');

            // 초기화
            $dlg.removeClass('is-ready');
            $dlg.find('#rhKeyword').text('—');
            $dlg.find('#memo-keyword-id').val(id);
            const $ta = $dlg.find('#memo-keyword-memo'); if (!$ta.is(':focus')) $ta.val('');
            $dlg.find('#rhList').html('');

            // 데이터
            $.getJSON('/slot/detail-history/' + id)
                .done(res => {
                    const slot = res?.slot || {};
                    const list = Array.isArray(res?.history) ? res.history : [];
                    $dlg.find('#rhKeyword').text([slot.KEYWORD, slot.MID].filter(Boolean).join(' / ') || '-');
                    $dlg.find('#memo-keyword-id').val(slot.ID || id);
                    if (!$ta.is(':focus')) $ta.val(slot.COMMENT || '');

                    const html = (list.length ? list : []).map(it => {
                        const delta = Math.abs(Number(it.ranking_change) || 0);
                        const dir = String(it.ranking_class || '').toLowerCase();
                        const mark = dir === 'rising' ? '▲' : dir === 'falling' ? '▼' : '—';
                        const right = delta ? `${mark} ${delta}` : '—';
                        return `
              <div class="rh-card">
                <div>
                  <div class="rh-card__date">${it.history_date_txt || ''}</div>
                  <div class="rh-card__rank">${it.ranking_txt || it.ranking || ''}</div>
                </div>
                <div class="rh-card__chg ${dir}">${right}</div>
              </div>`;
                    }).join('') || `<div class="rh-card"><div class="rh-card__date text-muted">기록 없음</div></div>`;
                    $dlg.find('#rhList').html(html);
                    requestAnimationFrame(() => $dlg.addClass('is-ready'));
                })
                .fail(() => {
                    $dlg.find('#rhList').html('<div class="rh-card"><div class="rh-card__date text-danger">불러오기 실패</div></div>');
                    requestAnimationFrame(() => $dlg.addClass('is-ready'));
                });
        }

        // 바텀시트 내부 "자세히 보기" 클릭 → 시트 닫힌 뒤 모달 열기
        $(document).off('click.mxsRank').on('click.mxsRank', '#mxvRankBtn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const id = $(this).attr('data-id') || $('#mxsSlot').data('id');
            afterSheetClose(() => openRankModal(id));
        });

        // 바텀시트 내부 "시간별 순위" 클릭 → 시트 닫힌 뒤 시간별 순위 모달 열기
        $(document).off('click.mxsHourly').on('click.mxsHourly', '.btn-hourly-mobile', function (e) {
            e.preventDefault();
            e.stopPropagation();
            const id = $(this).attr('data-id') || $('#mxsSlot').data('id');
            afterSheetClose(() => {
                const $dlg = $('#modal-hourly-rank');
                const $list = $dlg.find('#hrList');
                $dlg.find('#hrKeyword').text('시간별 순위');
                $list.empty();
                modalHourly && modalHourly.show();

                $.getJSON('/slot/detail-hourly/' + id)
                    .done(function (res) {
                        const data = res && res.data ? res.data : { items: [] };
                        if (data.keyword) {
                            $dlg.find('#hrKeyword').text(data.keyword + ' - 시간별 순위');
                        }
                        if (!data.items || !data.items.length) {
                            $list.html('<div class="text-muted">데이터가 없습니다.</div>');
                            return;
                        }
                        // 최신이 상단이므로, 상승/하락은 바로 다음(더 오래된) 항목과 비교
                        const items = data.items.slice(); // newest-first
                        const frag = document.createDocumentFragment();
                        for (let i = 0; i < items.length; i++) {
                            const cur = items[i];
                            const next = items[i + 1]; // older
                            const hourTxt = cur.time_txt || '--:--';
                            const rankNum = (cur.ranking && cur.ranking > 0) ? cur.ranking : null;
                            const rankTxt = (typeof cur.ranking_txt === 'string' && cur.ranking_txt.length)
                                ? cur.ranking_txt
                                : (rankNum ? (rankNum + '위') : '-');

                            let deltaClass = 'hr-delta--flat';
                            let deltaTxt = '변화없음';
                            if (next && rankNum !== null) {
                                const nextRank = (next.ranking && next.ranking > 0) ? next.ranking : null;
                                if (nextRank !== null) {
                                    const diff = nextRank - rankNum; // 양수면 상승(+)
                                    if (diff > 0) { deltaClass = 'hr-delta--up'; deltaTxt = '+' + diff; }
                                    else if (diff < 0) { deltaClass = 'hr-delta--down'; deltaTxt = String(diff); }
                                    else { deltaClass = 'hr-delta--flat'; deltaTxt = '변화없음'; }
                                } else {
                                    deltaClass = 'hr-delta--flat';
                                    deltaTxt = '-';
                                }
                            } else if (!next) {
                                // 가장 오래된 항목은 비교 대상 없음
                                deltaClass = 'hr-delta--flat';
                                deltaTxt = '-';
                            }

                            const div = document.createElement('div');
                            div.className = 'hr-item';
                            div.innerHTML = '<div class="hr-time">' + hourTxt + '</div>' +
                                            '<div class="hr-rank">' + rankTxt + '</div>' +
                                            '<div class="hr-delta ' + deltaClass + '">' + deltaTxt + '</div>';
                            frag.appendChild(div);
                        }
                        $list[0].appendChild(frag);
                    })
                    .fail(function () {
                        $list.html('<div class="text-danger">불러오기에 실패했습니다.</div>');
                    });
            });
        });

    </script>

    <script>
        // 메모 버튼 클릭 이벤트
        $(document).on('click', '.btn-memo', function() {
            const slotId = $(this).data('id');
            const memo = $(this).data('memo') || '';
            
            $('#memo-slot-id').val(slotId);
            $('#memo-content').val(memo);
            
            if (modalMemo) {
                modalMemo.show();
            }
        });

        // 메모 모달이 열릴 때 textarea에 포커스
        $('#modal-memo').on('shown.bs.modal', function () {
            $('#memo-content').focus();
        });

        // 메모 저장 버튼 클릭 이벤트
        $(document).on('click', '#btn-save-memo', function() {
            const slotId = $('#memo-slot-id').val();
            const memo = $('#memo-content').val();

            if (!slotId) {
                alert('슬롯 ID가 없습니다.');
                return;
            }

            $.ajax({
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                },
                url: '/slot/memo',
                method: 'POST',
                dataType: 'json',
                data: {
                    id: slotId,
                    memo: memo
                },
                success: function(response) {
                    if (response.result === 'success') {
                        alert(response.message);
                        
                        // 모달 닫기
                        if (modalMemo) {
                            modalMemo.hide();
                        }
                        
                        // 페이지 새로고침
                        location.reload();
                    } else {
                        alert(response.message || '메모 저장에 실패했습니다.');
                    }
                },
                error: function(xhr) {
                    alert('메모 저장에 실패했습니다.');
                    console.log(xhr);
                }
            });
        });
    </script>


</body>

</html>