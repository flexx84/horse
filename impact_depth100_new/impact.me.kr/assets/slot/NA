    <script>
        (() => {
            const SHEET_ID = 'mxsSlot', BLOCKER_ID = 'mxsBlocker', SHEET_Z = 125000, BLOCKER_Z = 124999;

            const $sheet = $('#' + SHEET_ID); if (!$sheet.length) return;
            const $panel = $sheet.find('.mxs-panel'), $body = $sheet.find('.mxs-body'), $header = $sheet.find('.mxs-header, .mxs-handle');

            /* ===== 스크롤 락 + 워치독 ===== */
            let LOCK = false, frozenY = 0, watchdog = null;
            const inPanel = t => !!(t && t.closest && t.closest('#' + SHEET_ID + ' .mxs-panel'));
            const inBody = t => !!(t && t.closest && t.closest('#' + SHEET_ID + ' .mxs-body'));

            function ensureBlocker() {
                let b = document.getElementById(BLOCKER_ID);
                if (!b) {
                    b = document.createElement('div'); b.id = BLOCKER_ID; b.setAttribute('aria-hidden', 'true');
                    const stop = e => { if (inPanel(e.target) && inBody(e.target)) return; e.preventDefault(); };
                    b.addEventListener('wheel', stop, { passive: false, capture: true });
                    b.addEventListener('touchmove', stop, { passive: false, capture: true });
                    document.body.appendChild(b);
                }
                Object.assign(b.style, { position: 'fixed', inset: '0', zIndex: String(BLOCKER_Z), pointerEvents: 'auto', background: 'transparent' });
                return b;
            }
            function preventKeys(e) {
                if (!LOCK) return;
                const t = e.target;
                if ((t.tagName && /input|textarea|select/i.test(t.tagName)) || t.isContentEditable) return;
                if (inPanel(t)) return;
                if (['Space', 'PageUp', 'PageDown', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.code)
                    || [32, 33, 34, 35, 36, 38, 40].includes(e.keyCode)) e.preventDefault();
            }
            function stick() { if (LOCK) window.scrollTo(0, frozenY); }

            function lockScroll() {
                if (LOCK) return;
                LOCK = true; frozenY = window.pageYOffset || window.scrollY || 0;
                ensureBlocker(); document.addEventListener('keydown', preventKeys, { capture: true });
                window.addEventListener('scroll', stick, { passive: false });
            }
            function unlockScroll() {
                if (!LOCK) return;
                LOCK = false; const b = document.getElementById(BLOCKER_ID); if (b && b.parentNode) b.parentNode.removeChild(b);
                document.removeEventListener('keydown', preventKeys, { capture: true });
                window.removeEventListener('scroll', stick, { passive: false });
                window.scrollTo(0, frozenY);
            }

            function watch() {
                clearInterval(watchdog);
                watchdog = setInterval(() => {
                    const open = $sheet.hasClass('is-open'); const has = !!document.getElementById(BLOCKER_ID);
                    if (open && !LOCK) lockScroll();
                    if (!open && LOCK) unlockScroll();
                    if (open && !has) ensureBlocker();
                }, 250);
            }
            new MutationObserver(() => { const open = $sheet.hasClass('is-open'); open ? lockScroll() : unlockScroll(); })
                .observe($sheet[0], { attributes: true, attributeFilter: ['class'] });
            watch();

            function fill(d) {
                $('#mxsTitle').text('코드 ' + (d.id || '-'));
                $('#mxsSub').text((d.agency || '-') + ' · D-' + (d.remaining || '-'));

                $('#mxvId').text(d.id || '-');
                $('#mxvAgency').text(d.agency || '-');
                $('#mxvRemain').text(d.remaining || '-');
                $('#mxvUser').text(d.user || '-');
                $('#mxvUserName').text(d.username || '-');

                $('#mxvKeyword').text(d.keyword || '-');
                $('#mxvRankKeyword').text(d.rankkeyword || '-');
                $('#mxvRanking').text(d.ranking || '-');

                const $rb = $('#mxvRankBtn');
                if ($rb.length) {
                    const hasId = !!(d.id && String(d.id).trim());
                    $rb.attr('data-id', hasId ? d.id : '').toggle(hasId);
                }

                // 오늘순위변화 업데이트
                const $trc = $('#mxvTodayRankChange');
                if ($trc.length) {
                    const todayRankChangeText = d.todayRankChange || '데이터 부족';
                    const todayRankChangeClass = d.todayRankChangeClass || 'rank-change--no-data';
                    $trc.text(todayRankChangeText).removeClass().addClass('rank-change rank-change--mobile ' + todayRankChangeClass);
                }

                // 첫순위변화 업데이트
                const $frc = $('#mxvFirstRankChange');
                if ($frc.length) {
                    const firstRankChangeText = d.firstRankChange || '데이터 부족';
                    const firstRankChangeClass = d.firstRankChangeClass || 'rank-change--no-data';
                    $frc.text(firstRankChangeText).removeClass().addClass('rank-change rank-change--mobile ' + firstRankChangeClass);
                }

                // 시간별 순위 버튼 data-id 설정
                const $hb = $('.btn-hourly-mobile');
                if ($hb.length) {
                    const hasId = !!(d.id && String(d.id).trim());
                    $hb.attr('data-id', hasId ? d.id : '').toggle(hasId);
                }

                if ($('#mxvUrlA').length) {
                    const u = d.url || '';
                    $('#mxvUrlA').text(u || '-')
                        .attr('href', u ? (/^https?:\/\//.test(u) ? u : 'https://' + u) : '#');
                }

                $('#mxvMid').length && $('#mxvMid').text(d.mid || '-');
                $('#mxvMid2').length && $('#mxvMid2').text(d.mid2 || '-');
                $('#mxvRankingStatus').length && $('#mxvRankingStatus').text(d.rankingStatus || '-');

                $('#mxvStart').text(d.start || '-');
                $('#mxvEnd').text(d.end || '-');

                $('#mxvCount').length && $('#mxvCount').text(d.count || '-');
                $('#mxvLastCount').length && $('#mxvLastCount').text(d.lastCount || '-');
                $('#mxvSettingCount').length && $('#mxvSettingCount').text(d.settingCount || '-');
                $('#mxvSettingCount2').length && $('#mxvSettingCount2').text(d.settingCount2 || '-');

                $('#mxvMemo').text(d.memo || '-');

                $('#mxsSlot').data('id', d.id || '');
            }





            /* ===== 열기/닫기 ===== */
            function openSheet(d) { fill(d); lockScroll(); $sheet.removeClass('is-closing').attr('aria-hidden', 'false'); requestAnimationFrame(() => $sheet.addClass('is-open')); }
            function closeSheet() {
                if (!$sheet.hasClass('is-open') || $sheet.hasClass('is-closing')) return;
                $sheet.addClass('is-closing').removeClass('is-open');
                const done = () => { $sheet.removeClass('is-closing').attr('aria-hidden', 'true'); unlockScroll(); };
                $panel.one('transitionend.mxs webkitTransitionEnd.mxs', e => { if (e.target === $panel[0]) done(); });
                setTimeout(done, 350);
            }


            // 시트 열기
